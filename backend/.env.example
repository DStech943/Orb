# PostgreSQL connection for crawler tables (`crawl_jobs`, `pages`, and so on).
# Keep it server-only.
DATABASE_URL=postgresql://orb:orb@127.0.0.1:5432/orb
# Optional: only set this when `cx_copilot` brand/content tables use a
# different Postgres instance. Leave unset when one database hosts everything.
SUPABASE_DATABASE_URL=

# Supabase REST configuration for brands and category updates. This key is
# publishable, does not bypass RLS, and is safe to use with the user's JWT.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Backend only. Used exclusively for the restricted Shopify Vault RPC; never
# expose it through VITE_ variables, client code, or source control.
SUPABASE_SERVICE_ROLE_KEY=

# Safety and crawling limits
USER_AGENT=OrbBot/1.0 (+https://yourdomain.com/bot)
MAX_PAGES_HARD_LIMIT=2000
FETCH_TIMEOUT=15
MAX_HTML_BYTES=5000000
PER_HOST_CONCURRENCY=1
CRAWL_DELAY=1.0
WORKER_BATCH=8
WORKER_CONCURRENCY=4
MAX_ATTEMPTS=3
ENABLE_JS_RENDER=false

# The worker reads these on startup. After changing docker-compose variables,
# recreate containers with `docker compose up -d`; `restart` keeps old values.

# Set true only for local development. Production startup rejects this value.
ENV=dev
AUTH_DISABLED=true
# Required whenever AUTH_DISABLED=false. Tokens must be HS256 signed and include
# `sub`, `org_id`, and an optional `exp` claim.
JWT_SECRET=change-me-before-enabling-auth
# Fallback workspace for verified Supabase users whose token does not include
# an org_id. Set this to the shared internal Orb workspace UUID in production.
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000002
# Comma-separated browser origins allowed to call this API. Add the exact
# deployed frontend origin(s), without a trailing slash.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Generation and Qdrant. All values below are server-only and are read from
# backend/.env. Never give any of them a VITE_ prefix or expose them to clients.
LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
LLM_MODEL=your-json-capable-model
EMBEDDING_BASE_URL=https://your-openai-compatible-provider.example/v1
EMBEDDING_MODEL=your-768-dimensional-embedding-model
EMBEDDING_DIMENSIONS=768
QDRANT_COLLECTION_PREFIX=
QDRANT_URL=https://your-qdrant.example
QDRANT_API_KEY=replace-with-qdrant-api-key
ORB_LLM_API_KEY=replace-with-llm-api-key
# Used only for source-to-draft generation. It may be the same provider key as
# ORB_LLM_API_KEY, but is kept separate so its limits and billing can be managed.
ORB_DRAFT_API_KEY=replace-with-draft-llm-api-key
# Google AI Studio supports the OpenAI-compatible endpoint below. Keep these
# separate from LLM_BASE_URL/LLM_MODEL when general Orb features use OpenRouter.
DRAFT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DRAFT_MODEL=gemini-3.5-flash-lite
# Optional when embeddings use the same provider/key as ORB_LLM_API_KEY.
ORB_EMBEDDING_API_KEY=

# Shopify Admin API. These are server-only; do not prefix them with VITE_.
# The installed custom app needs read_products, read_content and read_legal_policies.
SHOPIFY_THE_DEARIST_DOMAIN=your-store.myshopify.com
SHOPIFY_THE_DEARIST_TOKEN=replace-with-admin-api-token
SHOPIFY_ADMIN_API_VERSION=2025-10
