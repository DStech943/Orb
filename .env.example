VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Python API base URL. For a separately deployed Railway API, use its public
# domain, for example https://your-api.up.railway.app (no trailing /api).
# It does not contain Qdrant or database credentials.
VITE_ORB_API_URL=http://localhost:8000
# Deployed Datastraw Support Agent API. It powers the brand-isolated “Chat
# with AI” tester. Set this to the public agent origin, with no trailing path.
VITE_AGENT_API_URL=https://your-datastraw-agent.railway.app
# Leave this as mock until Supabase Auth, the Python API, and roles are deployed.
VITE_AUTH_MODE=mock
